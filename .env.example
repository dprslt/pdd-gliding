# Copy to .env.local for local development (`yarn dev`).

# Holfuy sensor password — sent as the `sw`/`pw` parameter to
# api.holfuy.com. Without it the Holfuy stations return no live or history
# data (the rest of the site still works).
HOLFUY_PASSWD=

# Canonical URL used by next-sitemap (robots.txt / sitemap.xml), at build
# time. Optional, defaults to https://pdd.dprslt.fr.
SITE_URL=https://pdd.dprslt.fr
